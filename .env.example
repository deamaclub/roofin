# Copy to .env (same folder you run roofin from) or ~/.roofin.env and fill in.
# Format: NAME=value. Quotes are optional; use single quotes if a value has spaces or symbols.
# Never commit .env (it's in .gitignore).

# --- required -------------------------------------------------------------
ROOFIN_SENDER_NAME='Your Name'
ROOFIN_SENDER_EMAIL='you@gmail.com'
ROOFIN_SENDER_ADDRESS='Your real postal address or PO box'

# --- recommended (all free) -------------------------------------------------
# Google Maps data with reviews. serpapi.com -> free plan -> Dashboard -> API key
SERPAPI_KEY=

# Telegram: @BotFather -> /newbot -> token. Message your bot, then run: roofin telegram-setup
ROOFIN_TELEGRAM_TOKEN=
ROOFIN_TELEGRAM_CHAT_ID=

# Stripe restricted key (start with rk_test_...). See README for the permissions to tick.
STRIPE_SECRET_KEY=

# Cloudflare Pages demo hosting. Token template "Edit Cloudflare Pages".
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ROOFIN_CF_PROJECT=roofdemos-yourname

# --- optional ---------------------------------------------------------------
# Auto-send email from Gmail (needs 2-step verification + an App Password). Leave empty to paste by hand.
ROOFIN_SMTP_USER=
ROOFIN_SMTP_PASSWORD=
# Fallback pay link if you don't use Stripe
ROOFIN_PAY_LINK=
